          "group": "positive_unseen_exclusivity",
          "label": 1,
          "score": 0.01572984118548034,
          "text": "Sana bunu kimse anlatmıyor: küçük bir alışkanlık ay sonunda beklediğinden çok daha fazla para bırakabilir."
        },
        {
          "id": "cbs_p04",
          "group": "positive_unseen_curiosity",
          "label": 1,
          "score": 0.15406727046954,
          "text": "Ben de inanmıyordum, ta ki aynı testi üç kez yapana kadar. Sonuç düşündüğümün tam tersiydi."
        },
        {
          "id": "cbs_p05",
          "group": "positive_unseen_withholding",
          "label": 1,
          "score": 0.2854383417006641,
          "text": "Bu detayı atlayan herkes aynı hataya düşüyor. İkinci adımın neden önemli olduğunu sona gelince anlayacaksın."
        },
        {
          "id": "cbs_p06",
          "group": "positive_caps_curiosity",
          "label": 1,
          "score": 0.25477176056491163,
          "text": "NEDEN HERKES BUNU YAPMAYA BAŞLADI? Cevap sandığınız kadar basit değil 👀"
        },
        {
          "id": "cbs_p08",
          "group": "positive_overpromise",
          "label": 1,
          "score": 0.018477041651737608,
          "text": "Bunu öğrendikten sonra eski yönteme dönmek istemeyeceksin. Küçük görünüyor ama etkisi beklediğimden büyük."
        },
        {
          "id": "cbs_p09",
          "group": "positive_withholding",
          "label": 1,
          "score": 0.14176217951221984,
          "text": "Herkes ilk seçeneğe bakıyor ama asıl mesele başka yerde. En sonda fark ettiğim detay sonucu değiştirdi."
        },
        {
          "id": "cbs_p11",
          "group": "positive_fear",
          "label": 1,
          "score": 0.13866847289755085,
          "text": "Birçok kişinin yaptığı bu hata fark edilmeden haftalarca devam ediyor. Sen de yapıyor olabilirsin."
        },
        {
          "id": "cbs_p12",
          "group": "positive_personal_hype",
          "label": 1,
          "score": 0.14636405733959454,
          "text": "Bugün denedim ve gerçekten beklemiyordum: küçücük bir değişiklik bütün çalışma akışımı tersine çevirdi."
        },
        {
          "id": "cbs_p13",
          "group": "positive_curiosity_gap",
          "label": 1,
          "score": 0.13913669596935244,
          "text": "İlk bakışta sıradan geliyor ama üçüncü örnekte ne demek istediğimi anlayacaksın."
        },
        {
          "id": "cbs_p14",
          "group": "positive_caps_promise",
          "label": 1,
          "score": 0.284596779073507,
          "text": "BİR DAHA AYNI HATAYI YAPMAYACAKSIN! Sebebi öğrendiğimde ben de şaşırdım."
