        },
        {
          "id": "cbs_p04",
          "group": "positive_unseen_curiosity",
          "label": 1,
          "score": 0.15406744888692744,
          "text": "Ben de inanmıyordum, ta ki aynı testi üç kez yapana kadar. Sonuç düşündüğümün tam tersiydi."
        },
        {
          "id": "cbs_p05",
          "group": "positive_unseen_withholding",
          "label": 1,
          "score": 0.2854381959902957,
          "text": "Bu detayı atlayan herkes aynı hataya düşüyor. İkinci adımın neden önemli olduğunu sona gelince anlayacaksın."
        },
        {
          "id": "cbs_p06",
          "group": "positive_caps_curiosity",
          "label": 1,
          "score": 0.25477159649257575,
          "text": "NEDEN HERKES BUNU YAPMAYA BAŞLADI? Cevap sandığınız kadar basit değil 👀"
        },
        {
          "id": "cbs_p08",
          "group": "positive_overpromise",
          "label": 1,
          "score": 0.01847704253232268,
          "text": "Bunu öğrendikten sonra eski yönteme dönmek istemeyeceksin. Küçük görünüyor ama etkisi beklediğimden büyük."
        },
        {
          "id": "cbs_p09",
          "group": "positive_withholding",
          "label": 1,
          "score": 0.14176215472389636,
          "text": "Herkes ilk seçeneğe bakıyor ama asıl mesele başka yerde. En sonda fark ettiğim detay sonucu değiştirdi."
        },
        {
          "id": "cbs_p11",
          "group": "positive_fear",
          "label": 1,
          "score": 0.13866842007540758,
          "text": "Birçok kişinin yaptığı bu hata fark edilmeden haftalarca devam ediyor. Sen de yapıyor olabilirsin."
        },
        {
          "id": "cbs_p12",
          "group": "positive_personal_hype",
          "label": 1,
          "score": 0.14636406282583345,
